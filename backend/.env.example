# ============================================
# 通海南洋 CRM 后端环境变量模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ==================== 基础配置 ====================
NODE_ENV=development
PORT=4000

# ==================== 数据库 ====================
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_db?schema=public"
# 数据库连接池参数（添加到 DATABASE_URL 末尾）:
# ?connection_limit=20&pool_timeout=10
# connection_limit: 连接池大小（默认: num_cpus*2+1，生产建议 20）
# pool_timeout: 等待连接的超时秒数（默认: 60，生产建议 10）

# ==================== Redis ====================
REDIS_URL="redis://:your_redis_password@localhost:6379"

# ==================== JWT 认证 ====================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==================== 2FA 加密 ====================
# 用于加密 TOTP Secret 的独立密钥（生产环境必须设置）
# 生成命令: openssl rand -base64 32
TWO_FA_ENCRYPTION_KEY=""

# ==================== 管理员初始化 ====================
# 用于 npm run db:seed:admin 脚本
ADMIN_EMAIL="admin@thny.sg"
ADMIN_PASSWORD="YourStrongP@ss1"

# ==================== 前端地址 (CORS) ====================
FRONTEND_URL="http://localhost:3000"
MANAGEMENT_URL="http://localhost:3001"
PORTAL_URL="http://localhost:3002"
MOBILE_URL="http://localhost:5173"

# ==================== 邮件服务 (SMTP) ====================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@thny.sg"

# ==================== 文件上传 ====================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ==================== AI/聊天服务（可选）====================
OPENAI_API_KEY=""
# OpenAI API 基础 URL（用于代理或兼容 API，如 Azure OpenAI）
OPENAI_BASE_URL=""
OPENAI_MODEL=""

# ==================== Prometheus Metrics ====================
# ⚠️ 生产环境必须设置，否则 /metrics 端点将拒绝访问
# 生成命令: openssl rand -hex 32
METRICS_BEARER_TOKEN=""
