# ============================================
# 通海南洋 CRM 后端环境变量模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ==================== 基础配置 ====================
NODE_ENV=development
PORT=4000

# ==================== 数据库 ====================
DATABASE_URL="postgresql://crm_user:crm_password@localhost:5432/crm_db?schema=public"

# ==================== Redis ====================
REDIS_URL="redis://:your_redis_password@localhost:6379"

# ==================== JWT 认证 ====================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==================== 管理员初始化 ====================
# 用于 npm run db:seed:admin 脚本
ADMIN_EMAIL="admin@thny.sg"
ADMIN_PASSWORD="YourStrongP@ss1"

# ==================== 前端地址 (CORS) ====================
FRONTEND_URL="http://localhost:3000"
MANAGEMENT_URL="http://localhost:3001"
PORTAL_URL="http://localhost:3002"

# ==================== 邮件服务 (SMTP) ====================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@thny.sg"

# ==================== 文件上传 ====================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ==================== AI/聊天服务（可选）====================
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""
