graph TD
    %% 系统架构概览
    subgraph Frontend [前端工作区 (Vue 3 + Vite)]
        direction TB
        W[Website<br/>(官网前台)]
        M[Management<br/>(管理后台)]
        P[Customer Portal<br/>(客户门户)]
        
        S[Shared<br/>(UI组件/工具/类型)]
    end

    subgraph BackendLayer [后端服务]
        LB[Express API Server]
        Auth[Auth Middleware]
        Services[Service Layer]
    end

    subgraph DataLayer [数据持久层]
        DB[(PostgreSQL)]
        Prisma[Prisma Client]
    end

    %% 依赖关系
    W --> S
    M --> S
    P --> S

    %% 数据交互
    W -->|Axios / API| LB
    M -->|Axios / API| LB
    P -->|Axios / API| LB

    %% 后端内部
    LB --> Auth
    Auth --> Services
    Services --> Prisma
    Prisma --> DB

    %% 样式定义
    classDef vue fill:#42b883,stroke:#35495e,color:white;
    classDef nodejs fill:#68a063,stroke:#333,color:white;
    classDef db fill:#336791,stroke:#333,color:white;
    classDef shared fill:#e6a23c,stroke:#d48806,color:white;

    class W,M,P vue;
    class LB,Auth,Services,Prisma nodejs;
    class DB db;
    class S shared;
